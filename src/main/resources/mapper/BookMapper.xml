    <update id="updateBookInfo">
        update book_info
        <set>
            <if test="bookName!=null">
                `book_name`=#{bookName},
            </if>
            <if test="author!=null">
                `author`=#{author},
            </if>
            <if test="count!=null">
                `count`=#{count},
            </if>
            <if test="price!=null">
                `price`=#{price},
            </if>
            <if test="publish!=null">
                `publish`=#{publish},
            </if>

            <if test="status!=null">
                `status`=#{status},
            </if>

        </set>
        where id=#{id}
    </update>
    <update id="updateBookById">
        update book_info set status=0
        where id in
        <foreach collection="ids" item="id" separator="," open="(" close=")">
            #{id}
        </foreach>
    </update>
</mapper>